#
# ~/.bashrc — thin loader; real config lives in ~/.config/bash/rc.d/
#

# ble.sh — source near the top, defer attach
[[ $- == *i* ]] && source /usr/share/blesh/ble.sh --noattach

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Load modular fragments in lexical order
for _rc in "$HOME"/.config/bash/rc.d/*.sh; do
	[ -r "$_rc" ] && . "$_rc"
done
unset _rc

# Machine-local overrides (secrets, host-specific) — not tracked in this repo
[ -f ~/.bashrc.local ] && . ~/.bashrc.local

# ble.sh attach — MUST be the last line
[[ ${BLE_VERSION-} ]] && ble-attach
